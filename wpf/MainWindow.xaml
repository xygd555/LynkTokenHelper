<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LynkSignTokenHelper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="领克凭据助手" Width="520" Height="700" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="#202329" Foreground="#F2F4F8" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown" SourceInitialized="WindowSourceInitialized" Loaded="WindowLoaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BitmapImage x:Key="AppLogo" UriSource="Branding/lynk-icon.png" />
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="Root" Background="#202329">
    <Grid x:Name="LoginView">
      <Border x:Name="LoginCardHost" Width="388" Margin="20,16" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#2B3038" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="15">
        <StackPanel>
          <Grid x:Name="LoginHeader" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="52" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="40" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Source="{StaticResource AppLogo}" Width="40" Height="40" HorizontalAlignment="Left" AutomationProperties.Name="lynk 项目图标" />
            <TextBlock Grid.Column="1" Text="连接服务器" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="BackButton" Grid.Column="2" Content="返回" Style="{StaticResource Subtle}" Padding="8,0" Click="BackClicked" Visibility="Hidden" ToolTip="返回工作台" AutomationProperties.Name="返回工作台" />
            <TextBlock x:Name="LoginSubtitle" Grid.Row="1" Grid.ColumnSpan="3" Text="使用 Lynk Sign 面板账号登录" Style="{StaticResource Muted}" Margin="0,8,0,0" />
          </Grid>
          <TextBlock x:Name="AddressLabel" Text="服务器地址" Margin="0,0,0,6" />
          <TextBox x:Name="Address" AutomationProperties.Name="服务器地址" Height="42" TextChanged="LoginInputChanged" ToolTip="完整的 HTTP 或 HTTPS 面板地址，可包含端口和子路径" />
          <TextBlock x:Name="UsernameLabel" Text="面板账号" Margin="0,14,0,6" />
          <TextBox x:Name="Username" AutomationProperties.Name="面板账号" Height="42" TextChanged="LoginInputChanged" />
          <TextBlock x:Name="PasswordLabel" Text="面板密码" Margin="0,14,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="Password" AutomationProperties.Name="面板密码" Height="42" PasswordChanged="PasswordChanged" />
            <TextBox x:Name="VisiblePassword" AutomationProperties.Name="显示的面板密码" Height="42" Visibility="Collapsed" TextChanged="VisiblePasswordChanged" />
            <Button x:Name="TogglePassword" Grid.Column="1" Style="{StaticResource Subtle}" Click="TogglePasswordClicked" ToolTip="显示密码" AutomationProperties.Name="显示或隐藏密码">
              <Path x:Name="PasswordIcon" Data="{StaticResource Icon_eye}" Style="{StaticResource Icon}" />
            </Button>
          </Grid>
          <CheckBox x:Name="AllowHttp" Content="允许内网 HTTP 明文连接" Margin="0,18,0,18" />
          <Button x:Name="LoginButton" Style="{StaticResource Primary}" Click="LoginClicked" IsEnabled="False">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="LoginButtonText" Text="正在准备…" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              <Path Data="{StaticResource Icon_arrow_right}" Style="{StaticResource Icon}" Margin="12,0,0,0" />
            </StackPanel>
          </Button>
          <Grid x:Name="LoginNoticeHost" Height="48" Margin="0,12,0,0">
            <TextBlock x:Name="LoginNotice" Foreground="#EDB5B7" FontSize="13" LineHeight="20" VerticalAlignment="Center" Visibility="Hidden" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <ScrollViewer x:Name="MainView" Visibility="Collapsed" Padding="26,14,26,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid MinHeight="{Binding ViewportHeight, ElementName=MainView}">
        <Grid.RowDefinitions>
          <RowDefinition Height="70" />
          <RowDefinition Height="*" />
          <RowDefinition Height="62" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="{StaticResource AppLogo}" Width="36" Height="36" Margin="0,0,12,0" AutomationProperties.Name="lynk 项目图标" />
            <StackPanel>
              <TextBlock Text="领克凭据助手" FontSize="18" FontWeight="SemiBold" />
              <TextBlock x:Name="ServerAddress" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="370" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="AccountName" VerticalAlignment="Center" MaxWidth="130" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
            <Button x:Name="SwitchButton" Content="切换服务器" Style="{StaticResource Subtle}" Click="SwitchClicked" />
          </StackPanel>
        </Grid>
        <Grid x:Name="Workbench" Grid.Row="1" Margin="0,0,0,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border x:Name="CapturePanel" Grid.Column="0" VerticalAlignment="Top" Background="#2A2E36" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="13" Padding="18">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="120" />
                <RowDefinition Height="56" />
                <RowDefinition Height="104" />
                <RowDefinition Height="72" />
                <RowDefinition Height="72" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <TextBlock Text="抓包状态" Foreground="#C3CBD7" />
                <Border HorizontalAlignment="Right" CornerRadius="5" Background="#16FFFFFF" Padding="8,2">
                  <TextBlock x:Name="CaptureBadge" Text="待开始" FontSize="12" Foreground="#B2BBC9" />
                </Border>
              </Grid>
              <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="14" Background="#303B4A" HorizontalAlignment="Center" Margin="0,0,0,12">
                  <Path x:Name="StatusIcon" Data="{StaticResource Icon_shield_checkmark}" Fill="#85BAFF" Width="28" Height="28" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                      <RotateTransform />
                    </Path.RenderTransform>
                  </Path>
                </Border>
                <TextBlock x:Name="CaptureTitle" Text="准备获取" Height="28" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="CaptureTime" Text="等待开始抓取" Height="22" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
              <Grid x:Name="Metrics" Grid.Row="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="Connections" Text="0" FontSize="27" HorizontalAlignment="Center" />
                  <TextBlock Text="连接" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="LynkRequests" Text="0" FontSize="27" HorizontalAlignment="Center" />
                  <TextBlock Text="领克请求" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="3" Margin="0,8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="40" />
                  <RowDefinition Height="8" />
                  <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <Button x:Name="StartButton" Style="{StaticResource Primary}" Click="StartClicked" IsEnabled="False">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon_arrow_sync}" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                    <TextBlock x:Name="StartButtonText" Text="开始抓取" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </StackPanel>
                </Button>
                <Button x:Name="StopButton" Content="停止抓取" Click="StopClicked" Visibility="Hidden" />
                <Button x:Name="MiniProgramButton" Grid.Row="2" Click="MiniProgramClicked" IsEnabled="False" ToolTip="已打开时会先关闭领克窗口，再重新打开；请先登录电脑版微信">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon_arrow_right}" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                    <TextBlock x:Name="MiniProgramButtonText" Text="打开领克小程序" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </StackPanel>
                </Button>
              </Grid>
              <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,16,0,0">
                <Grid VerticalAlignment="Top">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Path Data="{StaticResource Icon_shield_checkmark}" Fill="#B2BBC9" Width="23" Height="23" Stretch="Uniform" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="抓包证书" />
                    <TextBlock x:Name="CertificateStatus" Text="尚未安装" Style="{StaticResource Muted}" />
                  </StackPanel>
                  <Button x:Name="InstallButton" Grid.Column="2" Content="安装" Padding="10,0" Margin="8,0,0,0" VerticalAlignment="Center" Click="InstallClicked" ToolTip="安装抓包证书" AutomationProperties.Name="安装抓包证书" />
                </Grid>
              </Border>
              <TextBlock x:Name="CaptureGuide" Grid.Row="5" Style="{StaticResource Muted}" Height="60" LineHeight="20" Margin="0,12,0,0" VerticalAlignment="Top" />
            </Grid>
          </Border>
          <StackPanel x:Name="ResultPanel" Grid.Column="2" Margin="0,2,0,0">
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="抓取结果" FontSize="23" FontWeight="SemiBold" />
                <TextBlock x:Name="ResultHint" Text="获取后自动提交到服务器" Style="{StaticResource Muted}" Margin="0,4,0,0" />
              </StackPanel>
              <Button x:Name="CopyTokenButton" Grid.Column="1" VerticalAlignment="Top" Click="CopyTokenClicked" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource Icon_copy}" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                  <TextBlock Text="复制 Token" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
              </Button>
            </Grid>
            <StackPanel x:Name="CandidateField" Visibility="Collapsed" Margin="0,0,0,12">
              <TextBlock Text="选择捕获的凭据" Margin="0,0,0,7" />
              <ComboBox x:Name="Candidates" SelectionChanged="CandidateChanged" AutomationProperties.Name="选择捕获的凭据" />
            </StackPanel>
            <Grid Margin="0,0,0,9">
              <TextBlock x:Name="TokenLabel" Text="Refresh Token" />
              <TextBlock x:Name="TokenSource" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
            </Grid>
            <Grid>
              <TextBox x:Name="Token" Height="136" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="14" Foreground="#DCE9FF" Background="#191E26" BorderBrush="#1CFFFFFF" Padding="15,13" AutomationProperties.Name="捕获的 Refresh Token" />
              <TextBlock x:Name="TokenPlaceholder" Text="抓到的 refresh token 会显示在这里" Foreground="#8795AA" Margin="16,15,16,0" IsHitTestVisible="False" />
            </Grid>
            <Grid Margin="0,9,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="设备 ID" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBox x:Name="Device" Grid.Column="1" Text="尚未获取" IsReadOnly="True" Background="Transparent" BorderBrush="Transparent" Padding="0,8" FontFamily="Consolas" FontSize="13" Foreground="#C7D4E8" AutomationProperties.Name="捕获的设备 ID" />
              <Button x:Name="CopyDeviceButton" Grid.Column="2" Style="{StaticResource Subtle}" Click="CopyDeviceClicked" ToolTip="复制设备 ID" AutomationProperties.Name="复制设备 ID" IsEnabled="False">
                <Path Data="{StaticResource Icon_copy}" Style="{StaticResource Icon}" />
              </Button>
            </Grid>
            <Border x:Name="MainNotice" CornerRadius="9" Padding="15,13" Background="#282C33" BorderBrush="#12FFFFFF" BorderThickness="1" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="29" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Path x:Name="NoticeIcon" Data="{StaticResource Icon_shield_checkmark}" Fill="#85BAFF" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,0,0" />
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="NoticeTitle" Text="先安装抓包证书" FontWeight="SemiBold" />
                  <TextBlock x:Name="NoticeBody" Text="点击左侧“安装证书”，完成后即可开始抓取。" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="Confirmation" CornerRadius="10" Padding="16,12" Background="#292C2F" BorderBrush="#35E8CF9D" BorderThickness="1" Visibility="Collapsed" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="更换绑定账号" Foreground="#E8CF9D" FontSize="16" FontWeight="SemiBold" />
                <Grid Margin="0,10,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="新账号" Style="{StaticResource Muted}" />
                  <TextBlock x:Name="NewAccount" Grid.Column="1" />
                  <TextBlock Text="新账号 ID" Grid.Row="1" Style="{StaticResource Muted}" Margin="0,7,0,0" />
                  <TextBlock x:Name="NewAccountId" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" />
                  <TextBlock Text="原账号 ID" Grid.Row="2" Style="{StaticResource Muted}" Margin="0,7,0,0" />
                  <TextBlock x:Name="OldAccountId" Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" />
                </Grid>
                <TextBlock Text="确认后将替换服务器上的原账号凭据。" Style="{StaticResource Muted}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                  <Button x:Name="CancelButton" Content="取消换绑" Click="CancelClicked" Margin="0,0,10,0" />
                  <Button x:Name="ConfirmButton" Content="确认换绑" Style="{StaticResource Primary}" Click="ConfirmClicked" />
                </StackPanel>
              </StackPanel>
            </Border>
            <StackPanel x:Name="SubmitActions">
              <Button x:Name="SubmitButton" Content="提交服务器" Style="{StaticResource Primary}" Click="SubmitClicked" IsEnabled="False" />
              <TextBlock x:Name="BackupHint" Text="提交失败时，可复制 Token 手动填写。" Style="{StaticResource Muted}" Margin="0,11,0,0" Visibility="Collapsed" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
          <Grid Margin="0,11,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="ProxyDot" Width="6" Height="6" Fill="#98D4B1" Margin="0,0,8,0" />
              <TextBlock x:Name="ProxyState" Text="代理已恢复" Style="{StaticResource Muted}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="RestoreButton" Content="恢复代理" Style="{StaticResource Subtle}" Click="RestoreClicked" />
              <Button x:Name="RemoveButton" Content="移除证书" Style="{StaticResource Subtle}" Click="RemoveClicked" IsEnabled="False" />
              <Button x:Name="ExitButton" Content="退出" Style="{StaticResource Subtle}" Click="ExitClicked" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
    <Border x:Name="Toast" Background="#353D48" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10" Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="ToastText" />
    </Border>
  </Grid>
</Window>
