<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <OutputType>WinExe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LynkSignTokenHelper</RootNamespace>
    <AssemblyName>LynkSignTokenHelper-windows-x64</AssemblyName>
    <OutputPath>..\dist\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\branding\lynk-icon.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SkipMiniProgramCompatibilityChecks)' == 'true'">
    <DefineConstants>$(DefineConstants);WECHAT_LAUNCH_UNCHECKED</DefineConstants>
    <AssemblyName>LynkSignTokenHelper-windows-x64-unchecked</AssemblyName>
    <OutputPath>..\dist\unchecked\</OutputPath>
    <IntermediateOutputPath>obj\unchecked\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="App.cs" />
    <Compile Include="Models.cs" />
    <Compile Include="ToolUpdater.cs" />
    <Compile Include="UpdateInstaller.cs" />
    <Compile Include="MainWindow.Updates.cs" />
    <Compile Include="UpdateWindow.xaml.cs"><DependentUpon>UpdateWindow.xaml</DependentUpon></Compile>
    <Compile Include="CoreClient.cs" />
    <Compile Include="LynkMiniProgramLauncher.cs" />
    <Compile Include="WeChatMiniProgramRuntime.cs" />
    <Compile Include="WeChatRuntimeBridge.cs" />
    <Compile Include="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="obj\BuildInfo.cs" />
    <Page Include="MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="UpdateWindow.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Page Include="Theme.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Icons.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <EmbeddedResource Include="obj\Core.exe.gz">
      <LogicalName>LynkSignTokenHelper.Core.exe.gz</LogicalName>
    </EmbeddedResource>
    <Resource Include="..\assets\branding\lynk-icon.png">
      <Link>Branding\lynk-icon.png</Link>
    </Resource>
    <Resource Include="..\assets\branding\lynk-icon.ico">
      <Link>Branding\lynk-icon.ico</Link>
    </Resource>
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
</Project>
